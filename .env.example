# Mit Datenbank: Einrichtungscode für den ersten Administrator. Ohne Datenbank: gemeinsames Passwort. In Produktion zwingend setzen.
APP_PASSWORD=
# Optional: geheimer Schlüssel zum Signieren der Anmeldung (sonst wird er aus APP_PASSWORD abgeleitet)
SESSION_SECRET=

# Datenbank (Supabase) – nur serverseitig, der Service-Key darf nie im Browser landen
SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# KI-Analyse (optional, sonst Demo-Modus)
CLAUDE_API_KEY=
# CLAUDE_MODEL=

# Abomodell (optional): externe Benutzer registrieren sich selbst und bezahlen über Stripe.
# Aktiv, sobald die drei Stripe-Werte gesetzt sind. Webhook-Adresse in Stripe: https://<domain>/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Basis-Adresse der App für die Rücksprung-URLs von Stripe (empfohlen), z. B. https://diagnose.example.com
APP_URL=
# Anzeige in der Oberfläche (Preisangabe ist Pflicht) und Verweise auf die rechtlichen Seiten
SUBSCRIPTION_PRICE_LABEL=
TERMS_URL=
PRIVACY_URL=
IMPRINT_URL=
# Optional: kostenlose Testtage (1–90) und automatische Steuerberechnung (Stripe Tax muss eingerichtet sein)
# STRIPE_TRIAL_DAYS=7
# STRIPE_AUTOMATIC_TAX=true
