# Passwortschutz (gemeinsames Passwort für die Werkstatt). In Produktion zwingend setzen.
APP_PASSWORD=
# Optional: geheimer Schlüssel zum Signieren der Anmeldung (sonst wird er aus APP_PASSWORD abgeleitet)
SESSION_SECRET=

# Datenbank (Supabase) – nur serverseitig, der Service-Key darf nie im Browser landen
SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# KI-Analyse (optional, sonst Demo-Modus)
CLAUDE_API_KEY=
# CLAUDE_MODEL=
